[Unit]
Description=fzbots - llama.cpp server (DeepHat) local-only 127.0.0.1:8081
After=network.target

[Service]
Type=simple
ExecStart=/home/dev/null/llama.cpp/build/bin/llama-server \
  -m /root/.lmstudio/models/DeepHat/DeepHat-V1-7B.Q4_K_M.gguf \
  -ngl 99 -c 4096 -fa on \
  --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
