tunnel: <TUNNEL_ID>
credentials-file: /root/.cloudflared/<TUNNEL_ID>.json

# fzmultibotbackend — GERADO por `fzbots apply` a partir do bots.yml (só bots com hostname).
# Referência de formato; não editar o /etc/cloudflared/config.yml na mão.
ingress:
  - hostname: fzbots.rogerluft.com.br
    service: http://127.0.0.1:8081
  - service: http_status:404
